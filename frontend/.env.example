# Base URL of the deployed AURA-EVAL API. Leave EMPTY to use the local
# same-origin proxy defined in next.config.mjs (recommended for local dev).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only: where `next dev` proxies /api during local development.
API_PROXY_TARGET=http://127.0.0.1:8000
