# ============================================================
# AURA-EVAL — root environment template
#   cp .env.example .env      (used by docker-compose)
# The app runs end-to-end with NO API KEYS: LLM_PROVIDER=mock.
# Never commit a real .env — it is git-ignored.
# ============================================================

# --- Runtime -------------------------------------------------
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO
SERVERLESS=false                  # true on Vercel (uses NullPool)

# --- Database (managed Postgres in production) ---------------
# Local docker-compose value; override with Neon/Supabase/RDS URL.
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura_eval
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_DB=aura_eval
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- LLM provider --------------------------------------------
LLM_PROVIDER=mock                 # mock | openai | anthropic | gemini
DEFAULT_MODEL=mock-1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Pricing (USD per 1M tokens; configurable, never hardcoded)
PRICING_JSON={"mock-1":{"input":0.0,"output":0.0},"gpt-4o-mini":{"input":0.15,"output":0.60},"gpt-4o":{"input":2.50,"output":10.00},"claude-3-5-sonnet":{"input":3.00,"output":15.00},"gemini-1.5-pro":{"input":1.25,"output":5.00}}

# --- Workflow safety -----------------------------------------
MAX_RETRIES=2                     # refinement attempts per sample
MAX_WORKFLOW_STEPS=500            # hard loop ceiling
QUALITY_THRESHOLD=75              # auto-approve overall score
JUDGE_DISAGREEMENT_THRESHOLD=15

# --- Storage & queue -----------------------------------------
STORAGE_PROVIDER=local            # local | memory | blob | s3
STORAGE_DIR=.storage
BLOB_READ_WRITE_TOKEN=
TASK_QUEUE_PROVIDER=inline        # inline | qstash
QSTASH_TOKEN=

# --- Security ------------------------------------------------
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000     # comma separated; NEVER "*"
RATE_LIMIT_PER_MINUTE=120

# --- Demo data -----------------------------------------------
SEED_DEMO_DATA=true

# --- Frontend (public; must not contain secrets) -------------
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
