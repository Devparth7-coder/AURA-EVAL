# ─── Application ──────────────────────────────────────────────────────
ENVIRONMENT=development           # development | test | production
APP_URL=http://localhost:8000
LOG_LEVEL=INFO
API_PREFIX=/api

# ─── Database (§42) ───────────────────────────────────────────────────
# Local dev falls back to SQLite when unset. PRODUCTION MUST USE POSTGRES.
# Use a pooled/pgbouncer connection string for serverless deployments.
# DATABASE_URL=postgresql://user:password@host:5432/aura_eval
DATABASE_URL=sqlite+pysqlite:///./aura_eval.db
DB_ECHO=false

# ─── LLM providers (§9) — never exposed to the frontend ───────────────
LLM_PROVIDER=mock                 # mock | openai | gemini | anthropic
LLM_MODEL=mock-1
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ─── Workflow limits (§7, §34) ────────────────────────────────────────
MAX_RETRIES=3
MAX_WORKFLOW_STEPS=2000
MAX_SAMPLES_PER_RUN=500
MAX_COST_USD_PER_RUN=25
DEFAULT_SLICE_STEPS=40
APPROVAL_THRESHOLD=70
BORDERLINE_LOW=60
BORDERLINE_HIGH=75

# ─── Queue / background execution (§43) ───────────────────────────────
QUEUE_PROVIDER=mock               # mock | redis
REDIS_URL=

# ─── Object storage (§44) ─────────────────────────────────────────────
STORAGE_PROVIDER=local            # local | memory | blob | s3
STORAGE_DIR=./_storage
BLOB_READ_WRITE_TOKEN=

# ─── Security (§24, §47) ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
AUTH_ENABLED=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
